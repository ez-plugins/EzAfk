<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM-4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM-4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gyvex</groupId>
        <artifactId>ezafk-parent</artifactId>
        <version>3.1.1</version>
    </parent>

    <artifactId>ezafk</artifactId>
    <packaging>jar</packaging>
    <name>EzAfk Distribution</name>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/${github.repository}</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <dependency>
            <groupId>com.gyvex</groupId>
            <artifactId>ezafk-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gyvex</groupId>
            <artifactId>ezafk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gyvex</groupId>
            <artifactId>ezafk-paper-26.1</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.gyvex</groupId>
            <artifactId>ezafk-folia</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/../ezafk-core/src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>config.yml</include>
                    <include>gui.yml</include>
                    <include>mysql.yml</include>
                    <include>zones.yml</include>
                    <include>messages/**</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../ezafk-core/src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>mp3/ezafk-sound.mp3</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <fork>true</fork>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.bstats:bstats-bukkit</include>
                                    <include>org.bstats:bstats-base</include>
                                    <include>net.kyori:adventure-api</include>
                                    <include>net.kyori:adventure-key</include>
                                    <include>net.kyori:adventure-text-minimessage</include>
                                    <include>net.kyori:adventure-text-serializer-legacy</include>
                                    <include>net.kyori:examination-api</include>
                                    <include>net.kyori:examination-string</include>
                                    <include>javazoom:jlayer</include>
                                    <include>com.github.EzFramework:Jaloquent</include>
                                    <include>com.github.EzFramework:JavaQueryBuilder</include>
                                    <!-- Include our modules -->
                                    <include>com.gyvex:ezafk-api</include>
                                    <include>com.gyvex:ezafk-core</include>
                                    <include>com.gyvex:ezafk-paper-26.1</include>
                                    <include>com.gyvex:ezafk-folia</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.gyvex.ezafk.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.kyori</pattern>
                                    <shadedPattern>com.gyvex.ezafk.libs.net.kyori</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javazoom</pattern>
                                    <shadedPattern>com.gyvex.ezafk.libs.javazoom</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.ezframework</pattern>
                                    <shadedPattern>com.gyvex.ezafk.libs.ezframework</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>